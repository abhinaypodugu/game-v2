# ==========================================
# Catan Game Environment Configuration
# ==========================================

# Custom Admin Password for bot simulations, spectator tools & match speeds
# (Default built-in passwords always accepted: 'admin', 'catan-admin', 'admin123')
ADMIN_PASSWORD=my_admin_secret_password
VITE_ADMIN_PASSWORD=my_admin_secret_password

# Port for the Node server (default is 3001)
PORT=3001

# CORS Origins (comma-separated, optional)
# CORS_ORIGIN=http://localhost:5173,https://my-catan-domain.com

# Base URL path if deployed under a subpath
# BASE_PATH=/
